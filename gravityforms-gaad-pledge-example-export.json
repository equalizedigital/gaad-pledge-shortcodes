ext":"Save & Continue","limitEntries":false,"limitEntriesCount":"","limitEntriesPeriod":"","limitEntriesMessage":"","scheduleForm":true,"scheduleStart":"","scheduleEnd":"05\/21\/2026","schedulePendingMessage":"","scheduleMessage":"Global Accessibility Awareness Day has passed and this form is no longer accepting entries.","requireLogin":false,"requireLoginMessage":"","honeypotAction":"abort","enableGFZeroSpam":"1","deprecated":"","saveEnabled":"","enableHoneypot":false,"enableAnimation":false,"legacy":"","save":{"enabled":false,"button":{"type":"link","text":"Save & Continue"}},"scheduleStartHour":1,"scheduleStartMinute":0,"scheduleStartAmpm":"am","scheduleEndHour":11,"scheduleEndMinute":59,"scheduleEndAmpm":"pm","affwp_gravity_forms_registration":"","submitSpeedCheckThreshold":2000,"submitSpeedCheckMode":"normal","enableSpamConfirmation":false,"enableSubmitSpeedCheck":false,"feeds":{"gravityformsadvancedpostcreation":[]},"notifications":[{"id":"67f41f748489f","isActive":true,"to":"{admin_email}","name":"Admin Notification","event":"form_submission","toType":"email","subject":"{form_title} Pending Approval: {Name (First):1.3} {Name (Last):1.6}","message":"{all_fields}\r\n\r\n<a href=\"{entry_url}\">Approve this pledge here.<\/a>","service":"wordpress","toEmail":"{admin_email}","toField":"","routing":null,"fromName":"","from":"{admin_email}","replyTo":"","bcc":"","disableAutoformat":false,"enableAttachments":false,"notification_conditional_logic_object":"","notification_conditional_logic":"0","conditionalLogic":null,"cc":""},{"id":"68124a854a3a2","name":"User Notification","service":"wordpress","event":"form_submission","toType":"field","toEmail":"","toField":"3","routing":null,"fromName":"","from":"{admin_email}","replyTo":"","bcc":"","subject":"Thank you for pledging to make WordPress more accessible! Next steps...","message":"<div style=\"width:100;display:block;\"><img class=\"alignnone wp-image-5692\" src=\"https:\/\/equalizedigital.com\/wp-content\/uploads\/2021\/11\/Equalize-Digital-color-logo-450px-1.png\" alt=\"Equalize Digital websites for everyone logo.\" width=\"164\" height=\"60\" \/><\/div>\r\n\r\n<p>Hi {Name (First):1.3},<\/p>\r\n\r\n<p><strong>Thank you for pledging {How many hours are you pledging?:8} hours to make WordPress more accessible on May 21, 2026.<\/strong> Every contribution counts, and we're looking forward to seeing how much we can impact when we all focus on accessibility for a day.<\/p>\r\n<div style=\"border-radius: 5px; padding: 5px; border: 2px solid #84C77A; background: #E6F4E4; text-align: center; max-width: 500px;\">\r\n<h2><strong style=\"font-size: 17px; line-height: 150%; color: #000;\">Add a reminder to your calendar:<\/strong><\/h2>\r\n<p style=\"text-align: center;\"><a style=\"color: #286efa; text-decoration: underline; font-size: 15px;\" title=\"Apple\" href=\"https:\/\/www.addevent.com\/event\/9tlt9xgn5rcx+apple\" target=\"_blank\" rel=\"noopener\">Apple<\/a> <a style=\"color: #286efa; text-decoration: underline; font-size: 15px;\" title=\"Google\" href=\"https:\/\/www.addevent.com\/event\/9tlt9xgn5rcx+google\" target=\"_blank\" rel=\"noopener\">Google<\/a> <a style=\"color: #286efa; text-decoration: underline; font-size: 15px;\" title=\"Office 365\" href=\"https:\/\/www.addevent.com\/event\/9tlt9xgn5rcx+office365\" target=\"_blank\" rel=\"noopener\">Office 365<\/a> <a style=\"color: #286efa; text-decoration: underline; font-size: 15px;\" title=\"Outlook\" href=\"https:\/\/www.addevent.com\/event\/9tlt9xgn5rcx+outlook\" target=\"_blank\" rel=\"noopener\">Outlook<\/a> <a style=\"color: #286efa; text-decoration: underline; font-size: 15px;\" title=\"Outlook.com\" href=\"https:\/\/www.addevent.com\/event\/9tlt9xgn5rcx+outlookcom\" target=\"_blank\" rel=\"noopener\">Outlook.com<\/a> <a style=\"color: #286efa; text-decoration: underline; font-size: 15px;\" title=\"Yahoo\" href=\"https:\/\/www.addevent.com\/event\/9tlt9xgn5rcx+yahoo\" target=\"_blank\" rel=\"noopener\">Yahoo<\/a><\/p>\r\n\r\n<\/div>\r\n<h2 style=\"margin: 1em 0 0; font-size: 1.2em; font-weight: bold;\">Helpful links<\/h2>\r\nHere are some links to help if you're considering contributing to WordPress core:\r\n<ul class=\"wp-block-list\">\r\n \t<li>Core Accessibility Tickets\r\n<ul class=\"wp-block-list\">\r\n \t<li><a href=\"https:\/\/core.trac.wordpress.org\/query?status=!closed&amp;focuses=~accessibility\">All open tickets<\/a><\/li>\r\n \t<li><a href=\"https:\/\/core.trac.wordpress.org\/report\/30?FOCUS=accessibility\">All open tickets, grouped by workflow and sorted by component, type, summary<\/a><\/li>\r\n \t<li><a href=\"https:\/\/core.trac.wordpress.org\/query?status=!closed&amp;focuses=~accessibility&amp;keywords=~good-first-bug\">Good first bugs<\/a><\/li>\r\n \t<li><a href=\"https:\/\/core.trac.wordpress.org\/query?status=!closed&amp;focuses=~accessibility&amp;keywords=~has-patch\">Tickets with patches to test<\/a><\/li>\r\n<\/ul>\r\n<\/li>\r\n \t<li>Gutenberg Accessibility Issues\r\n<ul class=\"wp-block-list\">\r\n \t<li>Issues with\u00a0<a href=\"https:\/\/github.com\/WordPress\/gutenberg\/issues?q=is%3Aopen+is%3Aissue+label%3A%22%5BFocus%5D+Accessibility+%28a11y%29%22\">accessibility\u00a0focus<\/a><\/li>\r\n \t<li><a href=\"https:\/\/github.com\/WordPress\/gutenberg\/issues?q=is%3Aopen+is%3Aissue+label%3A%22Needs+Accessibility+Feedback%22\">Needs Accessibility Feedback label<\/a>, representing\u00a0UX\u00a0changes seeking feedback on accessibility.<\/li>\r\n<\/ul>\r\n<\/li>\r\n \t<li>Theme Accessibility-ready testing resources:\r\n<ul class=\"wp-block-list\">\r\n \t<li><a href=\"https:\/\/wpaccessibility.org\/docs\/testing\/testing-themes\/\">How to test WordPress themes for accessibility<\/a><\/li>\r\n \t<li><a href=\"https:\/\/wpaccessibility.org\/docs\/topics\/theme-guidelines\/\">Theme accessibility guidelines<\/a><\/li>\r\n<\/ul>\r\n<\/li>\r\n<\/ul>\r\nNew to testing? Check out this <a href=\"https:\/\/equalizedigital.com\/accessibility-checker\/how-to-manually-check-your-website-for-accessibility\/\">guide to manual accessibility testing.<\/a>\r\n<h2 style=\"margin: 1em 0 0; font-size: 1.2em; font-weight: bold;\">Zoom Workshop Information<\/h2>\r\nIf you indicated you were interested in joining the <strong>Theme Accessibility Testing Workshop<\/strong> at 10:00 AM Central (3:00 PM UTC), a <strong>separate email from Zoom<\/strong> will be sent shortly.\r\n\r\nDidn't sign up for the webinar when pledging? You can still <a href=\"https:\/\/us02web.zoom.us\/webinar\/register\/WN_1yHQDipZRKCusZyBYd3huQ#\/registration\">register here.<\/a>\r\n<h2 style=\"margin: 1em 0 0; font-size: 1.2em; font-weight: bold;\">Questions?<\/h2>\r\nIf you have questions during GAAD, here are places you can go to get help:\r\n<ul>\r\n \t<li>If your question is about contributing to WordPress Core or Gutenberg, post a question in the #accessibility channel in <a href=\"https:\/\/make.wordpress.org\/chat\/\">Make WordPress Slack<\/a>.<\/li>\r\n \t<li>If you have a different accessibility question, you can reach us directly in our <a href=\"https:\/\/www.facebook.com\/groups\/wordpress.accessibility\">Facebook group<\/a> or on Zoom during the workshop.<\/li>\r\n<\/ul>\r\nYou may also find this <a href=\"https:\/\/make.wordpress.org\/accessibility\/handbook\/get-involved\/\">accessibility team get involved guide<\/a> helpful.\r\n<h2 style=\"margin: 1em 0 0; font-size: 1.2em; font-weight: bold;\">After the event<\/h2>\r\n<strong>There's no reporting requirement, but we would love to hear how it goes!<\/strong>\r\nShare your progress or reflections on social media or in a blog post. Tag us @EqualizeDigital on social or reply to this email with a link. We\u2019ll share a round-up of posts and a summary of the contributions in our newsletter the following week.\r\n\r\n<p>Thank you again for your pledge,<\/br>\r\n\u2764\ufe0f The team at Equalize Digital<\/p>","disableAutoformat":true,"enableAttachments":false,"notification_conditional_logic_object":"","notification_conditional_logic":"0","conditionalLogic":null,"to":"3","cc":""}],"confirmations":[{"id":"67f41f748544b","name":"Default Confirmation","isDefault":true,"type":"message","message":"<div style=\"border-radius: 5px; padding: 10px; border: 2px solid #84C77A; background: #E6F4E4;\"><strong>Thanks for submitting your pledge! For security, we review submissions before publishing. Your pledge will be reviewed shortly and published on our webpage when approved.<\/strong><\/div>","url":"","pageId":"","queryString":"","event":"","disableAutoformat":false,"page":"","conditionalLogic":[]}]},"version":"2.9.7.2"}